#!/bin/sh
# Impeccable launcher. Runs a local engine binary; never downloads anything.
# Order: $IMPECCABLE_BIN, <this dir>/bin/<os>-<arch>/impeccable,
# ~/.impeccable/bin/impeccable, then `impeccable-engine` / `impeccable` on PATH.
# The home and PATH candidates must answer the engine-probe handshake: the
# retired 3.x npm CLI also installed a bin named `impeccable`.
# IMPECCABLE_BIN is the operator's explicit choice and is exec'd without a probe.
set -eu

# True when the candidate answers the engine handshake (prints
# "impeccable-engine <version>", exit 0). IMPECCABLE_LAUNCHER_PROBE marks the
# child as a probe so a copy of this launcher reached via PATH never loops.
probe_ok() {
  probe_out=$(IMPECCABLE_LAUNCHER_PROBE=1 "$1" engine-probe 2>/dev/null) || return 1
  case "$probe_out" in
    impeccable-engine*) return 0 ;;
  esac
  return 1
}
probing=${IMPECCABLE_LAUNCHER_PROBE:-}

dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
# VS Code syncs a plugin without the executable bit (#1249).
[ -x "$0" ] || chmod +x "$0" 2>/dev/null || :

# The binary needs the skill directory (reference/*.md, command-metadata.json)
# and how to name itself in the commands it prints.
: "${IMPECCABLE_SKILL_DIR:=$(CDPATH= cd -- "$dir/.." && pwd)}"
: "${IMPECCABLE_SELF:=$0}"
export IMPECCABLE_SKILL_DIR IMPECCABLE_SELF

if [ -n "${IMPECCABLE_BIN:-}" ] && [ -x "${IMPECCABLE_BIN}" ]; then
  exec "${IMPECCABLE_BIN}" "$@"
fi

case "$(uname -s 2>/dev/null || echo unknown)" in
  Darwin) os=darwin ;;
  Linux) os=linux ;;
  MINGW*|MSYS*|CYGWIN*|Windows_NT) os=windows ;;
  *) os=unknown ;;
esac
case "$(uname -m 2>/dev/null || echo unknown)" in
  arm64|aarch64) arch=arm64 ;;
  x86_64|amd64) arch=x64 ;;
  *) arch=unknown ;;
esac
exe=""
[ "$os" = windows ] && exe=".exe"

bin="$dir/bin/$os-$arch/impeccable$exe"
# Lost the executable bit in transit (zip extraction, some copiers).
if [ -f "$bin" ] && { [ -x "$bin" ] || chmod +x "$bin" 2>/dev/null; }; then
  exec "$bin" "$@"
fi

home_bin="${HOME:-}/.impeccable/bin/impeccable$exe"
if [ -n "${HOME:-}" ] && [ -x "$home_bin" ] && { [ -n "$probing" ] || probe_ok "$home_bin"; }; then
  exec "$home_bin" "$@"
fi

if [ -z "$probing" ]; then
  for name in impeccable-engine impeccable; do
    if command -v "$name" >/dev/null 2>&1 && probe_ok "$name"; then
      exec "$name" "$@"
    fi
  done
fi

echo "impeccable: no engine binary found (looked in IMPECCABLE_BIN, $bin, $home_bin, PATH)." >&2
echo "build it: cargo build --release -p impeccable, then set IMPECCABLE_BIN" >&2
exit 127
